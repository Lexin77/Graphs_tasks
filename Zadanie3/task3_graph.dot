graph G {
  rankdir=LR;
  node [shape=circle, style=filled, fillcolor=lightblue];
  "1" -- "2" [color=red, penwidth=2.0];
  "2" -- "3" [color=red, penwidth=2.0];
  "3" -- "4" [color=red, penwidth=2.0];
  "1" -- "4" [color=red, penwidth=2.0];
  "1" -- "3" [color=red, penwidth=2.0];
  "1" [fillcolor=red];
  "2" [fillcolor=yellow];
  "3" [fillcolor=red];
  "4" [fillcolor=yellow];
}
